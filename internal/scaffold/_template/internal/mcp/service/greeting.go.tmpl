package service

import (
	"context"
	"fmt"
	"strings"
)

// GreetingService provides greeting functionality.
type GreetingService interface {
	Greet(ctx context.Context, name string) string
}

type greetingServiceImpl struct{}

// NewGreetingService creates a new GreetingService.
func NewGreetingService() GreetingService {
	return &greetingServiceImpl{}
}

func (s *greetingServiceImpl) Greet(_ context.Context, name string) string {
	name = strings.TrimSpace(name)
	if name == "" {
		name = "World"
	}

	return fmt.Sprintf("Hello, %s!", name)
}
